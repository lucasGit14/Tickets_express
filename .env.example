# Copie para .env e ajuste conforme necessário.
# NÃO coloque segredos reais de produção neste arquivo.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/tickets_express
DB_USER=tickets_express
DB_PASSWORD=tickets_express_local
POSTGRES_DB=tickets_express
POSTGRES_USER=tickets_express
POSTGRES_PASSWORD=tickets_express_local

# Backend
JWT_SECRET=troque-por-uma-chave-com-no-minimo-32-caracteres
QR_SECRET=troque-por-uma-chave-qr-com-no-minimo-32-caracteres
CORS_ORIGIN=http://localhost:5173
TMDB_TOKEN=
RESERVATION_EXPIRATION_CHECK_MS=60000
SERVER_PORT=8080

# Frontend
VITE_API_URL=http://localhost:8080/api
